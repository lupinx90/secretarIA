# .env.example (Safe template for repository)
TELEGRAM_TOKEN=your_bot_token_here
CHAT_ID=your_chat_id_here
CHECK_INTERVAL=120
# Array of all possible IPv4 addresses assigned to your phone
IP_TARGETS=your_tracked_ip1,your_tracked_ip2,...
# manIA's private-LAN address; keep the API off the public internet
MANIA_STATUS_API_URL=full_api_endpoint_of_your_status_control_here